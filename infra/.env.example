POSTGRES_DB=opentrade
POSTGRES_USER=opentrade_owner
POSTGRES_PASSWORD=change-me-before-first-start
POSTGRES_PORT=5432

MINIO_ROOT_USER=opentrade_admin
MINIO_ROOT_PASSWORD=change-me-before-first-start
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
SNAPSHOT_BUCKET=opentrade-snapshots
RECORD_API_PORT=8787
CORS_ALLOWED_ORIGINS=http://localhost:4173
ANONYMOUS_SEARCH_LIMIT=60
ANONYMOUS_SEARCH_WINDOW_MS=60000

# Optional worker profile. Use a dedicated login role with membership in
# opentrade_worker; do not reuse the database owner credentials.
WORKER_DATABASE_URL=
OPENTRADE_WORKER_QUEUE=ingestion
OPENTRADE_WORKER_ID=ingestion-worker-1
OPENTRADE_WORKER_POLL_INTERVAL_MS=1000
OPENTRADE_WORKER_HEARTBEAT_INTERVAL_MS=30000
SNAPSHOT_STAGING_PATH=./snapshots
OPENTRADE_MAX_SNAPSHOT_BYTES=2147483648
# Comma-separated package exports, for example:
# @opentrade-registry/adapter-fl-dbpr:floridaDbprConstructionAdapter
OPENTRADE_WORKER_ADAPTERS=

# Optional. Configure both to enable developer API-key management.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Pin reviewed immutable image digests in production.
POSTGRES_IMAGE=postgres:17-alpine
MINIO_IMAGE=minio/minio:latest
MINIO_CLIENT_IMAGE=minio/mc:latest
