{
  "name": "@opentrade-registry/ingestion-worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Private v2 job lifecycle worker for OpenTrade Registry ingestion and verification jobs.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "enqueue": "node dist/enqueue-main.js",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1104.0",
    "@opentrade-registry/core": "workspace:*",
    "pg": "^8.16.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/pg": "^8.20.4"
  }
}
